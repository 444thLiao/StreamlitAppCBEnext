#!/usr/bin/env bash
set -euo pipefail

echo "TIMING - Starting Streamlit at: $(date)"

# Map the form's app value to its working directory and Streamlit entry point.
# Add future applications as another case here.
case "<%= context.app %>" in
  0)
    app_dir="/groups/burga/bioinfo/tianhua.liao/AF3_auto"
    app_file="af3_dashboard.py"
    ;;
  1)
    app_dir="/groups/burga/bioinfo/tianhua.liao/sRNAescape"
    app_file="GUI.py"
    ;;
  *)
    echo "Unknown application selection: <%= context.app %>" >&2
    exit 1
    ;;
esac

cd "${app_dir}"

# Calling the interpreter inside the existing environment avoids relying on
# interactive shell initialization for `conda activate` in a batch job.
source /software/system/miniforge3/miniforge3-26.7.2-0/etc/profile.d/conda.sh

conda activate /groups/burga/bioinfo/tianhua.liao/conda

/groups/burga/bioinfo/tianhua.liao/conda/bin/python -m streamlit run "${app_file}" \
  --server.port "${port}" \
  --server.baseUrlPath "${STREAMLIT_BASE_PATH}" \
  --server.headless true
